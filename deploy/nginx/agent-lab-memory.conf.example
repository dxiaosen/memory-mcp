server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name memory.example.com;

    ssl_certificate /etc/ssl/agent-lab/fullchain.pem;
    ssl_certificate_key /etc/ssl/agent-lab/privkey.pem;

    access_log /var/log/nginx/agent-lab-memory.access.log;
    error_log /var/log/nginx/agent-lab-memory.error.log warn;

    client_max_body_size 2m;

    location /mcp {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8765/health;
        proxy_http_version 1.1;
        access_log off;
    }
}
