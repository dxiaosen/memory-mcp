[Unit]
Description=Remote Memory MCP service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=memory-mcp
Group=memory-mcp
WorkingDirectory=/opt/memory-mcp
EnvironmentFile=/etc/memory-mcp/memory-mcp.env
ExecStart=/opt/memory-mcp/.venv/bin/memory-mcp
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/memory-mcp

[Install]
WantedBy=multi-user.target
