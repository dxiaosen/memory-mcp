[Unit]
Description=Agent Lab remote Memory MCP service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=agent-lab
Group=agent-lab
WorkingDirectory=/opt/agent-lab
EnvironmentFile=/etc/agent-lab/memory-mcp.env
ExecStart=/opt/agent-lab/.venv/bin/memory-mcp
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/agent-lab

[Install]
WantedBy=multi-user.target
