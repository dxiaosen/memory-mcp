[Unit]
Description=Apply Memory MCP PostgreSQL migrations
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=memory-mcp
Group=memory-mcp
WorkingDirectory=/opt/memory-mcp
EnvironmentFile=/etc/memory-mcp/memory-mcp.env
ExecStart=/opt/memory-mcp/.venv/bin/memory-mcp-db migrate
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/memory-mcp
