[Unit]
Description=Apply Agent Lab Memory PostgreSQL migrations
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=agent-lab
Group=agent-lab
WorkingDirectory=/opt/agent-lab
EnvironmentFile=/etc/agent-lab/memory-mcp.env
ExecStart=/opt/agent-lab/.venv/bin/memory-db migrate
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
