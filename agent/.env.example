# 单个 Agent Host 只需要 Memory MCP 地址和自己的凭据。
# profile_id、超时、召回预算和本地状态均使用安全默认值。
# Phase 1（模型自主调用 capture）后，capture 由模型自主调用
# capture_completed_turn MCP 工具，不再经 Agent 客户端。

MEMORY_MCP_URL=https://memory.example.com/mcp
MEMORY_MCP_TOKEN=replace-with-the-agent-token-at-least-32-characters

# recall HTTP 超时（默认 15s），需在用户请求开始前返回。
# MEMORY_HOOK_RECALL_TIMEOUT_SECONDS=15

