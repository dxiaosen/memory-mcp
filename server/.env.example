# Memory MCP Server 环境模板。
# 复制为受保护的运行配置，替换全部占位值，然后执行 chmod 600。
# 本文件只配置服务进程；Agent Host 使用 agent/.env.example。

# =============================================================================
# 数据库
# =============================================================================
# 用户名和密码中的 URI 保留字符必须进行百分号编码。
MEMORY_MCP_DATABASE_URL='postgresql://memory_app:replace-with-password@postgresql.internal:5432/memory_mcp?sslmode=require'
MEMORY_MCP_DATABASE_MIGRATE_ON_STARTUP=false
MEMORY_MCP_DATABASE_POOL_MIN_SIZE=1
MEMORY_MCP_DATABASE_POOL_MAX_SIZE=5
MEMORY_MCP_DATABASE_CONNECT_TIMEOUT_SECONDS=10

# =============================================================================
# HTTP 服务
# =============================================================================
# 除非受限私网或负载均衡器需要连接，否则保持监听 127.0.0.1。
MEMORY_MCP_HOST=127.0.0.1
MEMORY_MCP_PORT=8765
MEMORY_MCP_MCP_PATH=/mcp
MEMORY_MCP_HEALTH_PATH=/health
MEMORY_MCP_STATELESS_HTTP=true
MEMORY_MCP_MAX_CAPTURE_CHARACTERS=100000
MEMORY_MCP_RECALL_MAX_ITEMS=10
MEMORY_MCP_RECALL_MAX_TOKEN_BUDGET=1200
MEMORY_MCP_RECALL_CANDIDATE_LIMIT=500
MEMORY_MCP_MAINTENANCE_INTERVAL_SECONDS=300

# =============================================================================
# 认证
# =============================================================================
# 在宣称生产级身份能力前，必须用 OAuth/OIDC 替换静态认证。
# 每个静态 Token 至少包含 32 个字符。
MEMORY_MCP_AUTH_ISSUER_URL=https://memory.example.com/auth
MEMORY_MCP_RESOURCE_SERVER_URL=https://memory.example.com/mcp
MEMORY_MCP_AUTH_TOKENS='{"replace-with-random-token-at-least-32-characters":{"tenant_id":"tenant-001","subject_id":"subject-001","default_profile_id":"investment-research","team_ids":["research-dept"],"scopes":["memory:read","memory:write","memory:review"]}}'

# =============================================================================
# 敏感内容规则（可选）
# =============================================================================
# 未配置时使用内置默认规则（credential/account_secret/real_holding/
# transaction_instruction）。配置后完全替换默认规则集，每项为
# {"category": str, "pattern": str}。投研场景的默认 transaction_instruction
# 规则可能误伤"买入格力电器"这类研究偏好文本，可按需调整，但敏感规则是安全决策。
# MEMORY_MCP_SENSITIVE_RULES='[{"category":"project_codename","pattern":"阿波罗"}]'

# =============================================================================
# 模型与候选生成
# =============================================================================
# 真实模型配置不完整时，生产进程在启动阶段安全失败。
MEMORY_MCP_MODEL_PROVIDER=openai
MEMORY_MCP_MODEL_NAME=replace-with-model-name
MEMORY_MCP_MODEL_API_KEY=replace-with-api-key
MEMORY_MCP_MODEL_BASE_URL=https://api.openai.com/v1
MEMORY_MCP_MODEL_TEMPERATURE=0
MEMORY_MCP_MODEL_TIMEOUT_SECONDS=60
MEMORY_MCP_MODEL_MAX_RETRIES=2

# =============================================================================
# 日志
# =============================================================================
MEMORY_MCP_LOG_LEVEL=INFO
MEMORY_MCP_LOG_CONTENT=false
MEMORY_MCP_LOG_FILE=.memory-mcp/logs/memory-mcp.log
MEMORY_MCP_LOG_MAX_BYTES=10485760
MEMORY_MCP_LOG_BACKUP_COUNT=5
