{
  "description": "Memory MCP active recall and completed-turn capture.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-mcp-hook",
            "timeout": 20,
            "statusMessage": "正在召回长期记忆",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-mcp-hook",
            "timeout": 60,
            "statusMessage": "正在捕获本轮记忆"
          }
        ]
      }
    ]
  }
}
