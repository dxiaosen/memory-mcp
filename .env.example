# Chat model. Supported providers: deepseek, openai
CHAT_MODEL_PROVIDER=deepseek
CHAT_MODEL_NAME=deepseek-v4-flash
CHAT_MODEL_API_KEY=sk-your-chat-model-key
CHAT_MODEL_BASE_URL=https://api.deepseek.com
CHAT_MODEL_TEMPERATURE=0
CHAT_MODEL_TIMEOUT_SECONDS=60
CHAT_MODEL_MAX_RETRIES=2

# Embeddings use a separately approved OpenAI-compatible endpoint.
EMBEDDING_MODEL_PROVIDER=openai
EMBEDDING_MODEL_NAME=your-embedding-model
EMBEDDING_MODEL_API_KEY=sk-your-embedding-model-key
EMBEDDING_MODEL_BASE_URL=https://your-embedding-provider.example/v1
EMBEDDING_MODEL_TIMEOUT_SECONDS=60
EMBEDDING_MODEL_MAX_RETRIES=2

# Persistent knowledge base
VECTOR_STORE_PERSIST_DIRECTORY=.agent-lab/chroma
VECTOR_STORE_COLLECTION_NAME=agent-lab-knowledge
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4

# Agent runtime
AGENT_RECURSION_LIMIT=12
LOG_LEVEL=INFO
