# Copy this file to .env, replace every placeholder, then run: chmod 600 .env
# .env is ignored by Git. Never commit a real DSN, bearer token, or API key.
#
# PostgreSQL is the only runtime persistence backend. Reserved URI characters in
# usernames/passwords must be percent-encoded: @ -> %40, : -> %3A, / -> %2F,
# ? -> %3F, # -> %23, % -> %25.
# Keep sslmode=require only when the target instance has SSL enabled.
MEMORY_MCP_DATABASE_URL='postgresql://memory_app:replace-with-password@your-postgresql-host:5432/memory_mcp?sslmode=require'
# Fixed deployment default: migrate explicitly before starting the service.
MEMORY_MCP_DATABASE_MIGRATE_ON_STARTUP=false
MEMORY_MCP_DATABASE_POOL_MIN_SIZE=1
MEMORY_MCP_DATABASE_POOL_MAX_SIZE=5
MEMORY_MCP_DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Local/private-network listener. On ECS, 0.0.0.0 requires a source-restricted
# security group. The service can be accessed directly; Nginx is not required.
MEMORY_MCP_HOST=127.0.0.1
MEMORY_MCP_PORT=8765
MEMORY_MCP_MCP_PATH=/mcp
MEMORY_MCP_HEALTH_PATH=/health
MEMORY_MCP_STATELESS_HTTP=true
MEMORY_MCP_MAX_CAPTURE_CHARACTERS=100000
MEMORY_MCP_RECALL_MAX_ITEMS=10
MEMORY_MCP_RECALL_MAX_TOKEN_BUDGET=1200

# Prototype auth metadata. The resource URL defaults to the server's MCP URL.
MEMORY_MCP_AUTH_ISSUER_URL=http://localhost/demo-auth
# MEMORY_MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8765/mcp

# Prototype-only trusted token mapping. Replace every token locally.
# The matrix demonstrates same-owner/different-Agent sharing and cross-owner isolation.
# This entire value is a secret. It is test/demo identity infrastructure, not OAuth.
MEMORY_MCP_DEMO_TOKENS_JSON='{"replace-user-a-agent-a-token":{"owner_key":"demo-user-a","tenant_id":"demo","subject_id":"demo-user-a","client_id":"agent-a","agent_id":"agent-a","scopes":["memory:read","memory:write","memory:review"]},"replace-user-a-agent-b-token":{"owner_key":"demo-user-a","tenant_id":"demo","subject_id":"demo-user-a","client_id":"agent-b","agent_id":"agent-b","scopes":["memory:read","memory:write","memory:review"]},"replace-user-b-agent-b-token":{"owner_key":"demo-user-b","tenant_id":"demo","subject_id":"demo-user-b","client_id":"agent-b","agent_id":"agent-b","scopes":["memory:read","memory:write","memory:review"]}}'

# GeneralWorkPolicy is fixed in code and registers:
# preference, stable_context, ongoing_item, decision.

# Deterministic demo/test backend. It still uses the real MCP server, Core, and
# PostgreSQL; only candidate generation is fixed and offline.
# A fixture is returned only when source_expression occurs exactly in the turn.
MEMORY_MCP_EXTRACTOR_BACKEND=fixed
# Treat fixtures as sensitive if they contain real user text.
MEMORY_MCP_FIXED_CANDIDATES_JSON='[{"subject":"weekly-report","memory_type":"preference","content":"项目周报默认使用表格","assertion_kind":"user_view","source_expression":"以后项目周报默认用表格","save_rationale":"用户明确表达了长期格式偏好","confidence":0.98,"durability":"durable","expression_basis":"explicit"}]'

# Request logs contain stable hashes, metadata, counts, status, and latency only.
MEMORY_MCP_LOG_LEVEL=INFO
MEMORY_MCP_LOG_FILE=.memory-mcp/logs/memory-mcp.log
MEMORY_MCP_LOG_MAX_BYTES=10485760
MEMORY_MCP_LOG_BACKUP_COUNT=5

# Real model settings are inactive while EXTRACTOR_BACKEND=fixed.
# To enable them, set MEMORY_MCP_EXTRACTOR_BACKEND=openai-compatible.
# Supported providers are openai and deepseek.
# MEMORY_MCP_EXTRACTOR_BACKEND=openai-compatible
CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_NAME=replace-with-model-name
CHAT_MODEL_API_KEY=replace-with-api-key
# Omit CHAT_MODEL_BASE_URL for the provider default, or set a compatible endpoint.
CHAT_MODEL_BASE_URL=https://api.openai.com/v1
CHAT_MODEL_TEMPERATURE=0
CHAT_MODEL_TIMEOUT_SECONDS=60
CHAT_MODEL_MAX_RETRIES=2

# Independent Hook client profiles. Tokens must match the trusted server mapping.
# Only URL and token are required; omitted profile settings use documented defaults.
MEMORY_AGENT_A_MCP_URL=http://127.0.0.1:8765/mcp
MEMORY_AGENT_A_BEARER_TOKEN=replace-user-a-agent-a-token
MEMORY_AGENT_B_MCP_URL=http://127.0.0.1:8765/mcp
MEMORY_AGENT_B_BEARER_TOKEN=replace-user-a-agent-b-token
MEMORY_USER_B_AGENT_B_MCP_URL=http://127.0.0.1:8765/mcp
MEMORY_USER_B_AGENT_B_BEARER_TOKEN=replace-user-b-agent-b-token

# Optional per-profile overrides (replace AGENT_A with the selected profile prefix):
# MEMORY_AGENT_A_SCENARIO=general-work
# MEMORY_AGENT_A_TIMEOUT_SECONDS=15
# MEMORY_AGENT_A_FAIL_OPEN=true
# MEMORY_AGENT_A_RECALL_MAX_ITEMS=5
# MEMORY_AGENT_A_RECALL_TOKEN_BUDGET=600
# MEMORY_AGENT_A_CAPTURE_MAX_ATTEMPTS=3
# MEMORY_AGENT_A_CAPTURE_RETRY_DELAY_SECONDS=0.1
# MEMORY_AGENT_A_RUN_CACHE_MAX_ENTRIES=1000
